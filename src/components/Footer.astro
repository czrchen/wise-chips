---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="brand">
        <span class="brand-mark">Wise</span>
        <span class="brand-text">Cottage Fries</span>
      </a>
      <p>Crinkle-cut potato chips since 1986 — bold flavours, big crunch. Made in Malaysia by BJC Foods.</p>
      <div class="socials">
        <a href="https://www.facebook.com/CottageFriesMY/" aria-label="Facebook">Facebook</a>
        <a href="#" aria-label="Instagram">Instagram</a>
      </div>
    </div>

    <div class="footer-col">
      <h4>Explore</h4>
      <a href="/">Home</a>
      <a href="/about">About Us</a>
      <a href="/products">Products</a>
      <a href="/contact">Contact</a>
    </div>

    <div class="footer-col">
      <h4>Flavours</h4>
      <a href="/products">BBQ</a>
      <a href="/products">Hot &amp; Spicy</a>
      <a href="/products">Sour Cream &amp; Onion</a>
      <a href="/products">Sweet Thai Chilli</a>
    </div>

    <div class="footer-col">
      <h4>Get in touch</h4>
      <p class="muted">BJC Foods (M) Sdn Bhd · Lot 1, Jalan Pelabur 23/1, Seksyen 23, 40300 Shah Alam, Selangor</p>
      <a href="tel:+60355423566">+603-5542 3566</a>
      <a href="mailto:info@bjcfoods.com">info@bjcfoods.com</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {year} BJC Foods (M) Sdn Bhd · Brand owner of Wise Cottage Fries</span>
    <span>Shah Alam, Malaysia</span>
  </div>
</footer>

<style>
  .footer { position: relative; background: var(--ink); color: #D8C7BE; margin-top: 110px; padding: 70px 0 30px; }
  .footer-inner { display: grid; grid-template-columns: 1.7fr 1fr 1fr 1.4fr; gap: 40px; }
  .brand { display: flex; align-items: baseline; gap: 8px; margin-bottom: 18px; }
  .brand-mark { font-family: var(--font-display); font-weight: 800; font-size: 1.6rem; color: var(--red); letter-spacing: -0.03em; }
  .brand-text { font-family: var(--font-display); font-weight: 600; font-size: .95rem; color: #fff; }
  .footer-brand p { color: #A8978D; max-width: 330px; font-size: .95rem; line-height: 1.6; }

  .socials { display: flex; gap: 18px; margin-top: 22px; }
  .socials a { font-size: .88rem; font-weight: 500; color: #A8978D; transition: color .2s ease; }
  .socials a:hover { color: var(--gold); }

  .footer-col h4 {
    font-family: var(--font-display); font-size: .8rem; letter-spacing: .12em; text-transform: uppercase;
    margin-bottom: 18px; color: #8A776C;
  }
  .footer-col a { display: block; color: #D8CFC8; padding: 6px 0; font-size: .95rem; transition: color .18s ease; }
  .footer-col a:hover { color: #fff; }
  .footer-col .muted { color: #A8978D; margin-bottom: 14px; font-size: .95rem; line-height: 1.6; }

  .footer-bottom {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px;
    margin-top: 54px; padding-top: 26px;
    border-top: 1px solid rgba(255,255,255,.08);
    color: #8A776C; font-size: .86rem;
  }

  @media (max-width: 860px) { .footer-inner { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .footer-inner { grid-template-columns: 1fr; gap: 30px; } }
</style>
